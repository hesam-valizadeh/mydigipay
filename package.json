{
	"name": "mydigipay",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build --stats-json",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test:unit": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "npm run cy:run:coverage && nyc report",
		"test:ci": "jest --runInBand --coverage",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix",
		"stylelint": "stylelint \"src/**/*.{scss,css}\"",
		"stylelint:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"cy:open": "cypress open",
		"cy:run": "cypress run",
		"cy:run:component": "cypress run --component",
		"cy:run:e2e": "cypress run --e2e",
		"cy:run:coverage": "cypress run --component --env codeCoverageTasksRegistered=true",
		"prepare": "husky",
		"commit": "cz",
		"analys": "npx esbuild-visualizer --metadata dist/stats.json --open"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^21.2.12",
		"@angular/common": "^21.2.12",
		"@angular/compiler": "^21.2.12",
		"@angular/core": "^21.2.12",
		"@angular/forms": "^21.2.12",
		"@angular/platform-browser": "^21.2.12",
		"@angular/platform-browser-dynamic": "^21.2.12",
		"@angular/router": "^21.2.12",
		"@angular/service-worker": "^21.2.12",
		"bootstrap": "^5.3.7",
		"rxjs": "~7.8.0",
		"swiper": "^12.0.3",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-builders/jest": "^21.0.3",
		"@angular-devkit/core": "^21.2.10",
		"@angular-eslint/builder": "21.3.1",
		"@angular-eslint/eslint-plugin": "^21.3.1",
		"@angular-eslint/eslint-plugin-template": "^21.3.1",
		"@angular-eslint/schematics": "^21.3.1",
		"@angular-eslint/template-parser": "21.3.1",
		"@angular/build": "^21.2.10",
		"@angular/cli": "^21.2.10",
		"@angular/compiler-cli": "^21.2.12",
		"@badeball/cypress-cucumber-preprocessor": "^24.0.0",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@cucumber/cucumber": "^12.6.0",
		"@cypress/code-coverage": "^3.14.7",
		"@istanbuljs/nyc-config-typescript": "^1.0.2",
		"@types/bootstrap": "^5.2.10",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"angular-cli-ghpages": "^2.0.3",
		"angular-eslint": "^21.3.1",
		"autoprefixer": "^10.4.24",
		"babel-plugin-istanbul": "^7.0.1",
		"commitizen": "^4.3.1",
		"cypress": "^15.9.0",
		"cypress-axe": "^1.7.0",
		"cz-conventional-changelog": "^3.3.0",
		"esbuild": "^0.27.2",
		"esbuild-visualizer": "^0.7.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.4.1",
		"jest-preset-angular": "^16.1.5",
		"json-server": "^1.0.0-beta.3",
		"lint-staged": "^16.2.7",
		"prettier": "3.8.3",
		"stylelint": "^17.2.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.0.0",
		"ts-jest": "^29.4.6",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.59.3"
	}
}
