{
  "root": true,
  "ignorePatterns": [
    "projects/**/*",
    "dist/**/*",
    "node_modules/**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "parserOptions": {
        "project": [
          "tsconfig.app.json",
          "tsconfig.spec.json"
        ],
        "createDefaultProgram": false
      },
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@typescript-eslint/recommended-requiring-type-checking",
        "plugin:@typescript-eslint/strict",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        // --- ۱. مهندسی دقیق تایپ‌ها (Type Engineering) ---
        "@typescript-eslint/explicit-function-return-type": [
          "error",
          {
            "allowExpressions": false
          }
        ], // اجبار مطلق به خروجی تمام توابع
        "@typescript-eslint/explicit-member-accessibility": [
          "error",
          {
            "accessibility": "explicit"
          }
        ], // اجبار به public/private/protected
        "@typescript-eslint/no-explicit-any": [
          "error",
          {
            "fixToUnknown": true
          }
        ], // Any کاملاً ممنوع
        "@typescript-eslint/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "never"
          }
        ],
        "@typescript-eslint/no-unnecessary-condition": "error", // جلوگیری از شرط‌های همیشه برقرار یا همیشه غلط
        "@typescript-eslint/strict-boolean-expressions": "error", // اجازه نمی‌دهد متغیر غیر Boolean را مستقیماً در if بگذاری (باید مقایسه کنی)
        // --- ۲. امنیت عملیاتی و مدیریت Promise ---
        "@typescript-eslint/no-floating-promises": "error", // هیچ پرومیسی نباید رها شود
        "@typescript-eslint/await-thenable": "error",
        "@typescript-eslint/no-misused-promises": "error",
        "@typescript-eslint/switch-exhaustiveness-check": "error", // اجبار به پوشش تمام حالت‌های Enum در Switch
        // --- ۳. نظم و چیدمان کلاس (Architectural Integrity) ---
        "@typescript-eslint/member-ordering": [
          "error",
          {
            "default": [
              "public-static-field",
              "protected-static-field",
              "private-static-field",
              "public-instance-field",
              "protected-instance-field",
              "private-instance-field",
              "constructor",
              "public-instance-method",
              "protected-instance-method",
              "private-instance-method"
            ]
          }
        ],
        "max-lines": [
          "error",
          {
            "max": 250,
            "skipComments": true
          }
        ], // فایل طولانی نشانه معماری غلط است
        "complexity": [
          "error",
          7
        ], // پیچیدگی منطقی بسیار پایین برای خوانایی حداکثری
        "max-params": [
          "error",
          3
        ], // توابع شلوغ ممنوع
        // --- ۴. استانداردهای پیشرفته آنگولار (Angular On-Push & Performance) ---
        "@angular-eslint/prefer-on-push-component-change-detection": "error", // اجبار به استفاده از OnPush برای سرعت فضایی اپلیکیشن
        "@angular-eslint/use-lifecycle-interface": "error",
        "@angular-eslint/prefer-standalone": "error",
        "@angular-eslint/no-queries-metadata-property": "error",
        "@angular-eslint/no-lifecycle-call": "error",
        // --- ۵. پاکیزگی کد (Clean Code) ---
        "no-console": [
          "error",
          {
            "allow": [
              "error",
              "warn"
            ]
          }
        ],
        "eqeqeq": [
          "error",
          "always"
        ],
        "no-magic-numbers": [
          "error",
          {
            "ignore": [
              0,
              1,
              -1
            ],
            "ignoreArrayIndexes": true
          }
        ], // عدد بدون هویت ممنوع
        "@typescript-eslint/naming-convention": [
          "error",
          {
            "selector": "interface",
            "format": [
              "PascalCase"
            ],
            "prefix": [
              "I"
            ]
          },
          {
            "selector": "class",
            "format": [
              "PascalCase"
            ]
          },
          {
            "selector": "variable",
            "format": [
              "camelCase",
              "UPPER_CASE"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "*.html"
      ],
      "parser": "@angular-eslint/template-parser", // این خط حیاتی است
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "plugin:@angular-eslint/template/accessibility"
      ],
      "rules": {
        "@angular-eslint/template/no-call-expression": "error", // توابع در HTML ممنوع (فقط Pipe یا Signal)
        "@angular-eslint/template/no-any": "error",
        "@angular-eslint/template/use-track-by-property": "error", // اجبار به TrackBy برای بهینه‌سازی لیست‌ها
        "@angular-eslint/template/attributes-order": "error",
        "@angular-eslint/template/no-distracting-elements": "error",
        "@angular-eslint/template/conditional-complexity": [
          "error",
          {
            "maxComplexity": 2
          }
        ]
      }
    }
  ]
}